function [F, gradF, HessF] = problem_16(x)

    % Banded trigonometric problem

    x = x(:);
    n = length(x);
    
    if mod(n, 2) ~= 0
        error('Dimension n must be an even number for Problem 12.');
    end
    
    k = n / 2;
    
    odd = 1:2:n-1;
    even = 2:2:n;
    
    x_odd = x(odd);
    x_even = x(even);
    
    diff_x = x_odd - x_even;             % (x_{i-1} - x_i)
    x_odd_minus_3 = x_odd - 3;           % (x_{i-1} - 3)
    exp_term = exp(20 * diff_x);         % exp(20(x_{i-1} - x_i))
    S = sum(x_odd_minus_3);              % Sommatoria interna elevata al quadrato
    
    
    F = sum( (x_odd_minus_3.^2) / 1000 - diff_x + exp_term ) + S^2;
    
    % if we don't want the gradient
    if nargout < 2
        return;
    end
    
    
    gradF = zeros(n, 1);
    
    gradF(odd) = x_odd_minus_3 / 500 - 1 + 20 * exp_term + 2 * S;
    
    gradF(even) = 1 - 20 * exp_term;
    
    % if we don't want the Hessian
    if nargout < 3
        return;
    end
    
    
    HessF = zeros(n, n);
    
    HessF(odd, odd) = 2; 
    
    for j = 1:k
        o = 2*j - 1; % Indice dispari corrente
        e = 2*j;     % Indice pari corrente
        
        HessF(o, o) = HessF(o, o) + 1/500 + 400 * exp_term(j);
        HessF(e, e) = 400 * exp_term(j);
        
        HessF(o, e) = -400 * exp_term(j);
        HessF(e, o) = -400 * exp_term(j);
    end
end